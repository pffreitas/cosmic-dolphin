  "shape": {
    "radius": {
      "r-xs": "4px",
      "r-sm": "6px",
      "r-md": "8px",
      "r-lg": "12px",
      "r-pill": "999px"
    },
    "usage": {
      "r-sm": "buttons, inputs, chips, ghost hit areas",
      "r-md": "cards, panels, thumbnails, dialogs, AI callouts",
      "r-lg": "the app frame and the AI callout",
      "r-pill": "the header capsule and its nav pills, tags, avatars, segmented filters, and the primary CTA \u2014 nothing else"
    }
  },
  "space": {
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "12px",
