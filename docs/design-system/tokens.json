  "shape": {
    "radius": {
      "r-xs": "4px",
      "r-sm": "6px",
      "r-md": "8px",
      "r-lg": "12px",
      "r-brand": "7px",
      "r-pill": "999px"
    },
    "usage": {
      "r-sm": "secondary/ghost controls, Library thumbnails; fields use r-md",
      "r-md": "cards, panels, feed thumbnails, dialogs, AI callouts, fields",
      "r-lg": "compact dialog top corners and grouped empty-state panels",
      "r-brand": "the landing's closing logo lockup, and nothing else",
      "r-pill": "primary CTA, tags, avatars, segmented controls, capture field and brand capsule"
    }
  },
  "space": {
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "12px",
      "s-4": "16px",
      "s-5": "24px",
      "s-6": "32px",
      "s-7": "48px",
      "s-8": "64px"
    },
    "measure": "68ch"
  },
  "motion": {
    "ease": "cubic-bezier(0.2, 0.6, 0.3, 1)",
    "duration-fast": "150ms",
    "duration": "220ms"
  },
  "elevation": {
    "note": "Shadows only for surfaces that genuinely float. `{nav-shadow}` is an alias — it resolves to the header-capsule shadow of the same mode. Dark only overrides what changes.",
    "light": {
      "shadow-capsule": "{nav-shadow}",
      "shadow-popover": "0 12px 32px -12px rgba(28, 22, 16, 0.2), 0 2px 6px -3px rgba(28, 22, 16, 0.1)",
      "shadow-dialog": "0 24px 60px -20px rgba(28, 22, 16, 0.32)",
      "shadow-floating-nav": "0 4px 14px -2px rgba(28, 22, 16, 0.16), 0 1px 4px 0 rgba(28, 22, 16, 0.06)",
      "shadow-segment": "0 1px 2px 0 rgba(0,0,0,.05)"
    },
    "dark": {
      "shadow-popover": "0 12px 32px -12px rgba(0, 0, 0, 0.7), 0 2px 6px -3px rgba(0, 0, 0, 0.5)",
      "shadow-dialog": "0 24px 60px -20px rgba(0, 0, 0, 0.8)",
      "shadow-floating-nav": "0 4px 14px -2px rgba(0, 0, 0, 0.4), 0 1px 4px 0 rgba(0, 0, 0, 0.2)",
      "shadow-segment": "inset 0 0 0 1px var(--cd-border-strong)"
    }
  },
  "framing": {
    "feed-item": "article/video panels; Home lead and separator-row variants",
    "library-row": "separator-rows",
    "elevation": "Floating dialogs, sheets, menus, palette and toasts; selected segmented controls have a small shadow. No feed or list elevation.",
