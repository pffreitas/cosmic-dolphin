  "shape": {
    "radius": {
      "r-xs": "4px",
      "r-sm": "6px",
      "r-md": "8px",
      "r-lg": "12px",
      "r-pill": "999px"
    },
    "usage": {
      "r-sm": "buttons, inputs, chips, ghost hit areas",
      "r-md": "cards, panels, thumbnails, dialogs, AI callouts",
      "r-lg": "the app frame and the AI callout",
      "r-pill": "the header capsule and its nav pills, tags, avatars, segmented filters, and the primary CTA — nothing else"
    }
  },
  "space": {
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "12px",
      "s-4": "16px",
      "s-5": "24px",
      "s-6": "32px",
      "s-7": "48px",
      "s-8": "64px"
    },
    "measure": "68ch"
  },
  "motion": {
    "ease": "cubic-bezier(0.2, 0.6, 0.3, 1)",
    "duration-fast": "150ms",
    "duration": "220ms"
  },
  "elevation": {
    "note": "Shadows only for surfaces that genuinely float. `{nav-shadow}` is an alias — it resolves to the header-capsule shadow of the same mode. Dark only overrides what changes.",
    "light": {
      "shadow-capsule": "{nav-shadow}",
      "shadow-popover": "0 12px 32px -12px rgba(28, 22, 16, 0.2), 0 2px 6px -3px rgba(28, 22, 16, 0.1)",
      "shadow-dialog": "0 24px 60px -20px rgba(28, 22, 16, 0.32)"
    },
    "dark": {
      "shadow-popover": "0 12px 32px -12px rgba(0, 0, 0, 0.7), 0 2px 6px -3px rgba(0, 0, 0, 0.5)",
      "shadow-dialog": "0 24px 60px -20px rgba(0, 0, 0, 0.8)"
    }
  },
  "framing": {
    "feed-item": "bordered-panels",
    "library-row": "separator-rows",
    "elevation": "Shadows on the header capsule, dialogs, popovers and the command palette. Nothing in a feed or list floats.",
    "header": "content-sized opaque glass capsule on an unpainted header"
  }
}
