{
  "$schema-note": "Cosmic Dolphin design tokens. Semantic names only \u2014 components must never reference a raw hex.",
  "id": "signal",
  "name": "Signal",
  "tagline": "Deep blue-cyan on cool neutrals. Bordered feed panels, glass header capsule on a cyan band.",
  "typography": {
    "families": {
      "sans": "\"Inter\",system-ui,-apple-system,\"Segoe UI\",sans-serif",
      "serif": "\"Source Serif 4\",Georgia,\"Times New Roman\",serif",
      "mono": "\"IBM Plex Mono\",ui-monospace,SFMono-Regular,monospace"
    },
    "usage": {
      "serif": "Content the user evaluates: feed titles, library titles, detail titles, headings inside saved content, pull quotes.",
      "sans": "Everything the user operates: nav, buttons, metadata, tags, comments, forms, counts.",
      "mono": "Machine facts: domains, counts, keyboard shortcuts, ids."
    },
    "scale": {
      "display": {
        "family": "serif",
        "size": "40px",
        "line": "1.1",
        "weight": 600
      },
      "title-1": {
        "family": "serif",
        "size": "29px",
        "line": "1.2",
        "weight": 600
      },
      "title-2": {
        "family": "serif",
        "size": "20px",
        "line": "1.3",
        "weight": 600
      },
      "title-3": {
        "family": "serif",
        "size": "17px",
        "line": "1.35",
        "weight": 600
      },
      "body": {
        "family": "sans",
        "size": "15px",
        "line": "1.65",
        "weight": 400
      },
      "body-sm": {
        "family": "sans",
        "size": "13.5px",
        "line": "1.55",
        "weight": 400
      },
      "meta": {
        "family": "sans",
        "size": "12.5px",
        "line": "1.4",
        "weight": 400
      },
      "label": {
        "family": "sans",
        "size": "11px",
        "line": "1.3",
        "weight": 600,
        "transform": "uppercase",
        "tracking": "0.09em"
      },
      "quote": {
        "family": "serif",
        "size": "19px",
        "line": "1.5",
        "weight": 400,
        "style": "italic"
      }
    }
  },
