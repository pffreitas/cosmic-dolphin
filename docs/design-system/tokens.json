{
  "$schema-note": "Cosmic Dolphin design tokens. Semantic names only — components must never reference a raw hex.",
  "id": "signal",
  "name": "Signal",
  "tagline": "Warm ink on stone greys. Colour is kept for people, sources and state; nothing is tinted to look machine-made.",
