          "description": "API health failed; save acceptance is unverified. Check the API app's deployment, logs and domain.",
          "runbook_url": "https://github.com/pffreitas/cosmic-dolphin/blob/main/docs/runbooks/save-bookmark-monitoring.md#api-health-failed",
          "__dashboardUid__": "cosmic-save-bookmarks",
          "__panelId__": "2"
        },
        "notificationSettings": {
          "type": "SimplifiedRouting",
          "receiver": "REPLACE_EXISTING_RECEIVER",
          "groupBy": [
            "grafana_folder",
            "alertname",
            "environment"
          ],
          "groupWait": "30s",
          "groupInterval": "5m",
          "repeatInterval": "4h"
        },
        "expressions": {
          "A": {
            "datasourceUID": "REPLACE_METRICS_UID",
            "relativeTimeRange": {
              "from": "45m",
              "to": "0s"
            },
            "model": {
              "expr": "1 - sum(last_over_time(cosmic_save_api_up{environment=\"production\",journey=\"save_bookmark\"}[45m]))",
              "instant": true,
              "refId": "A"
            }
          },
          "B": {
            "source": true,
            "model": {
              "type": "threshold",
              "expression": "A",
              "refId": "B",
              "conditions": [
                {
                  "evaluator": {
                    "type": "gt",
                    "params": [
                      0
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
