  "rules": [
    {
      "apiVersion": "rules.alerting.grafana.app/v1beta1",
      "kind": "AlertRule",
      "metadata": {
        "name": "cosmic-save-monitoring-failed",
        "namespace": "default",
        "annotations": {
          "grafana.app/folder": "cosmic-save-monitor",
          "grafana.com/provenance": "api"
        }
      },
      "spec": {
        "title": "Save monitor cannot observe the database",
        "trigger": {
          "interval": "1m"
        },
        "for": "1m",
        "noDataState": "Alerting",
        "execErrState": "Error",
        "labels": {
          "managed_by": "cosmic-save-monitor",
          "service": "cosmic-dolphin",
          "environment": "production",
          "journey": "save_bookmark",
          "severity": "critical",
          "code": "monitoring_failed"
        },
        "annotations": {
          "summary": "Save monitor cannot observe the database",
          "description": "Save health is unknown. Fix the checker's target, credentials, grants or network before trusting any green run.",
          "runbook_url": "https://github.com/pffreitas/cosmic-dolphin/blob/main/docs/runbooks/save-bookmark-monitoring.md#monitoring-failed",
          "__dashboardUid__": "cosmic-save-bookmarks",
          "__panelId__": "2"
        },
        "notificationSettings": {
          "type": "SimplifiedRouting",
          "receiver": "REPLACE_EXISTING_RECEIVER",
          "groupBy": [
            "grafana_folder",
            "alertname",
            "environment"
          ],
          "groupWait": "30s",
          "groupInterval": "5m",
          "repeatInterval": "4h"
        },
        "expressions": {
          "A": {
            "datasourceUID": "REPLACE_METRICS_UID",
            "relativeTimeRange": {
              "from": "45m",
              "to": "0s"
            },
            "model": {
              "expr": "1 - sum(last_over_time(cosmic_save_monitor_observer_up{environment=\"production\",journey=\"save_bookmark\"}[45m]))",
              "instant": true,
              "refId": "A"
            }
          },
          "B": {
            "source": true,
            "model": {
              "type": "threshold",
              "expression": "A",
              "refId": "B",
              "conditions": [
                {
                  "evaluator": {
                    "type": "gt",
                    "params": [
                      0
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "apiVersion": "rules.alerting.grafana.app/v1beta1",
      "kind": "AlertRule",
      "metadata": {
        "name": "cosmic-save-api-health-failed",
