            "expr": "sum(last_over_time({service_name=\"cosmic-log-bridge\",deployment_environment_name=\"production\"} |= \"log_bridge_heartbeat\" | json event=\"event\", acceptedBatches=\"acceptedBatches\" | event=\"log_bridge_heartbeat\" | unwrap acceptedBatches | __error__=\"\" [5m]))",
