          "name": "source",
          "label": "Runtime source",
          "type": "custom",
          "query": "cosmic-dolphin-api,cosmic-dolphin-worker,cosmic-dolphin-web,cosmic-dolphin-save-monitor",
          "multi": true,
          "includeAll": true,
          "allValue": "cosmic-dolphin-api|cosmic-dolphin-worker|cosmic-dolphin-web|cosmic-dolphin-save-monitor",
          "current": {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          "options": [
            {
              "text": "All",
              "value": "$__all",
              "selected": true
            },
            {
              "text": "cosmic-dolphin-api",
              "value": "cosmic-dolphin-api",
              "selected": false
            },
            {
              "text": "cosmic-dolphin-worker",
              "value": "cosmic-dolphin-worker",
              "selected": false
            },
            {
              "text": "cosmic-dolphin-web",
              "value": "cosmic-dolphin-web",
              "selected": false
            },
