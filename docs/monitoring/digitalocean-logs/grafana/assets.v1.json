  "rules": [
    {
      "apiVersion": "rules.alerting.grafana.app/v1beta1",
      "kind": "AlertRule",
      "metadata": {
        "name": "cosmic-logs-heartbeat",
        "namespace": "default",
        "annotations": {
          "grafana.app/folder": "cosmic-production-logs",
          "grafana.com/provenance": "api"
        }
      },
      "spec": {
        "title": "Production log bridge heartbeat missing",
        "trigger": {
          "interval": "1m"
        },
        "for": "2m",
        "noDataState": "Alerting",
        "execErrState": "Error",
        "labels": {
          "managed_by": "cosmic-log-bridge",
          "environment": "production",
          "source": "bridge",
          "service": "cosmic-log-bridge",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Log bridge has not delivered a heartbeat for 5 minutes",
          "description": "Check the bridge deployment and OTLP ingestion. Native source coverage is unknown even when a heartbeat is present.",
          "runbook_url": "https://github.com/pffreitas/cosmic-dolphin/blob/main/docs/runbooks/digitalocean-logs.md#missing-bridge-heartbeat",
          "__dashboardUid__": "cosmic-production-logs",
          "__panelId__": "6"
        },
        "notificationSettings": {
          "type": "SimplifiedRouting",
          "receiver": "REPLACE_EXISTING_RECEIVER",
          "groupBy": [
            "grafana_folder",
            "alertname",
            "environment"
          ],
          "groupWait": "30s",
          "groupInterval": "5m",
          "repeatInterval": "4h"
        },
        "expressions": {
          "A": {
            "datasourceUID": "REPLACE_LOKI_UID",
            "relativeTimeRange": {
              "from": "5m",
              "to": "0s"
            },
            "model": {
              "expr": "sum(count_over_time({service_name=\"cosmic-log-bridge\",deployment_environment_name=\"production\"} |= \"log_bridge_heartbeat\" [5m])) or vector(0)",
              "instant": true,
              "queryType": "instant",
              "refId": "A"
            }
          },
          "B": {
            "source": true,
            "model": {
              "type": "threshold",
              "expression": "A",
              "refId": "B",
              "conditions": [
                {
                  "evaluator": {
                    "type": "lt",
                    "params": [
                      1
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
