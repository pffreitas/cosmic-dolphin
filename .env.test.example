# Optional. The test harness already defaults to the container defined in
# docker-compose.test.yml, so you normally need no .env.test at all:
#
#   bun run db:test:up && bun run db:test:reset
#   bun run test:backend
#
# Copy this file to .env.test only to override the port or credentials.
#
# Never point this at a hosted Supabase project. The suite TRUNCATEs every table
# in `public` before each test. The harness refuses to run unless the host is
# loopback and the database carries the `__test_database_marker` table that
# scripts/db-test-reset.mjs creates, but do not rely on that to protect real data.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
NODE_ENV=test
