# Copy this file to .env and fill in your actual values

# Node.js Environment
NODE_ENV=development

# API Configuration
API_PORT=3030
HOST=0.0.0.0

# Worker Configuration
WORKER_PORT=3002
QUEUE_AUTO_START=true
QUEUE_POLL_INTERVAL=5000
QUEUE_MAX_RETRIES=3
QUEUE_BATCH_SIZE=10
QUEUE_CONCURRENCY=5
QUEUE_GRACEFUL_SHUTDOWN_TIMEOUT=30000
QUEUE_NAMES=default,bookmarks,digests
DIGEST_SCHEDULER_ENABLED=true
# DIGEST_CRON=0 6 * * *

# Database Configuration (Supabase)
DATABASE_URL=postgresql://username:password@hostname:5432/database_name
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Logging
LOG_LEVEL=info

# External Services (Add your API keys here)
OPENROUTER_API_KEY=your-openrouter-api-key

# Search / RAG
RAG_MODEL=google/gemini-2.5-flash
EMBEDDING_MODEL=openai/text-embedding-3-small
