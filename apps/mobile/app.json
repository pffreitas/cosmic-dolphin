{
  "expo": {
    "name": "Cosmic Dolphin",
    "slug": "cosmic-dolphin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cosmicdolphin",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/launch/mark@3x.png",
      "resizeMode": "contain",
      "backgroundColor": "#160D1B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cosmicdolphin.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent"
      },
      "icon": {
        "light": "./assets/images/icon-light.png",
        "dark": "./assets/images/icon-dark.png"
      },
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)com.cosmicdolphin.shared"
        ],
        "com.apple.security.application-groups": [
          "group.com.cosmicdolphin.app"
        ]
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content",
      "translucent": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#050509",
        "backgroundImage": "./assets/images/adaptive-icon-background.png"
      },
      "package": "com.cosmicdolphin.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/launch/mark@3x.png",
          "resizeMode": "contain",
          "backgroundColor": "#160D1B",
          "imageWidth": 144
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1
          },
          "androidIntentFilters": [
            "text/*"
          ],
          "androidMultiIntentFilters": [
            "text/*"
          ],
          "customScheme": "cosmicdolphin",
          "disableIOS": true
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f4af56aa-569f-41af-83af-86e8def9d764"
      }
    },
    "owner": "cosmic-dolphin"
  }
}
